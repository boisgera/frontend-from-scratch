// @ts-nocheck
"civet autoLet react jsxCode"

// Colors ported from boisgera/python's src/components/Admonition.astro
// (light-mode values only; that Astro component also supports a dark
// theme, icons via astro-icon, and a locked/non-collapsible mode, none
// of which this project has an equivalent for).
colors :=
  note:
    light: "#e0f2fe"
    dark: "#164e63"
  warning:
    light: "#ffedd5"
    dark: "#ea580c"
  solution:
    light: "#fbcfe8"
    dark: "#db2777"
  definition:
    light: "#ccfbf1"
    dark: "#0d9488"
  task:
    light: "#cbd5e1"
    dark: "#334155"

function capitalize(word)
  word.charAt(0).toUpperCase() + word.slice(1)

export function Admonition({ type = "note", title, open = true, children })
  { light, dark } := colors[type] ?? colors.note
  label := title ?? capitalize(type)
  <details
    open=open
    css =
      border: `0.125rem solid ${dark}`
      borderRadius: "0.25rem"
      marginBottom: "1rem"
  >
    <summary
      css =
        padding: "1rem"
        backgroundColor: light
        borderRadius: "0.25rem"
        listStyle: "none"
        fontWeight: 500
        cursor: "pointer"
        "&::-webkit-details-marker":
          display: "none"
    >
      label
    <div
      css =
        margin: "1rem"
    >
      children
