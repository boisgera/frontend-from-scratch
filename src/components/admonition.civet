// @ts-nocheck
"civet autoLet react jsxCode"

import { ArrowsMaximizeIcon } from ../icons/arrows-maximize.js
import { ArrowsMinimizeIcon } from ../icons/arrows-minimize.js
import { PencilIcon } from ../icons/pencil.js
import { AlertTriangleIcon } from ../icons/alert-triangle.js
import { BulbIcon } from ../icons/bulb.js
import { TagIcon } from ../icons/tag.js
import { ChecklistIcon } from ../icons/checklist.js

// Colors ported from boisgera/python's src/components/Admonition.astro
// (light-mode values only; that Astro component also supports a dark
// theme and a locked/non-collapsible mode, neither of which this project
// has an equivalent for). The open/closed toggle icons and per-type badge
// icons are ported too, via src/icons (see there for why they're inlined
// SVG rather than a package).
colors :=
  note:
    light: "#e0f2fe"
    dark: "#164e63"
  warning:
    light: "#ffedd5"
    dark: "#ea580c"
  solution:
    light: "#fbcfe8"
    dark: "#db2777"
  definition:
    light: "#ccfbf1"
    dark: "#0d9488"
  task:
    light: "#cbd5e1"
    dark: "#334155"

icons :=
  note: PencilIcon
  warning: AlertTriangleIcon
  solution: BulbIcon
  definition: TagIcon
  task: ChecklistIcon

function capitalize(word)
  word.charAt(0).toUpperCase() + word.slice(1)

export function Admonition({ type = "note", title, open = true, children })
  { light, dark } := colors[type] ?? colors.note
  TypeIcon := icons[type] ?? icons.note
  label := title ?? capitalize(type)
  <details
    open
    css =
      marginBottom: "1rem"
      border: `0.125rem solid ${dark}`
      borderRadius: "0.25rem"
      "&[open] .icon-open":
        display: "inline"
      "&[open] .icon-closed":
        display: "none"
      "&:not([open]) .icon-open":
        display: "none"
      "&:not([open]) .icon-closed":
        display: "inline"
  >
    <summary
      css =
        paddingInline: "2rem"
        paddingBlock: "1rem"
        display: "flex"
        alignItems: "center"
        justifyContent: "space-between"
        backgroundColor: light
        borderRadius: "0.25rem"
        listStyle: "none"
        cursor: "pointer"
        "&::-webkit-details-marker":
          display: "none"
    >
      <span css = { display: "flex", gap: "0.5em", alignItems: "center" }>
        <span
          css =
            height: "1.25rem"
            width: "1.25rem"
            borderRadius: "0.25rem"
            backgroundColor: dark
            color: "white"
            display: "flex"
            justifyContent: "center"
            alignItems: "center"
        >
          <TypeIcon>
        <span css = { fontWeight: 500 }>label</span>
      <span css = { color: dark, display: "flex" }>
        <ArrowsMaximizeIcon className="icon-closed">
        <ArrowsMinimizeIcon className="icon-open">
    <div
      css =
        paddingInline: "2rem"
        paddingBlock: "1rem"
        "& > *:last-child":
          marginBottom: 0
    >
      children
