// @ts-nocheck
"civet autoLet react jsxCode"

// Compact person card: a small avatar (two text lines tall) next to the
// person's name -- bold, linking to their website, followed by small grey
// GitHub/email icon links that light up on hover -- with their affiliation
// in grey underneath.
import { Avatar } from ./avatar.js
import { GithubIcon } from ../icons/github.js
import { MailIcon } from ../icons/mail.js
import { fontSize, space } from ../styles.js

avatarSize := "2.5rem"
lineHeight := "1.25rem"

// The ", &:link, &:visited"/"&:hover, &:active" variants exist to
// out-specificity the global "a:link, a:visited"/"a:hover, a:active"
// rules in styles.civet, which otherwise win over a plain class selector.
nameLinkCss :=
  fontWeight: 500
  fontSize: fontSize.S
  textDecoration: "none"
  "&, &:link, &:visited":
    color: "#1e293b"
  "&:hover, &:active":
    color: "#2563eb"
    textDecoration: "none"

iconLinkCss :=
  display: "inline-flex"
  transition: "color 0.15s ease"
  "&, &:link, &:visited":
    color: "#94a3b8"
  "&:hover, &:active":
    color: "#2563eb"

export function PersonCard({ name, affiliation, email, github, website })
  githubHandle := github?.replace(/^@/, "")
  avatarUrl := if githubHandle then `https://github.com/${githubHandle}.png?size=128` else undefined
  <div css = { display: "flex", alignItems: "center", gap: space.S }>
    if avatarUrl
      <Avatar src={avatarUrl} size={avatarSize} />
    <div css = { display: "flex", flexDirection: "column" }>
      <div css = { display: "flex", alignItems: "center", gap: space.XS, lineHeight: lineHeight }>
        if website
          <a href={website} target="_blank" rel="noreferrer" css=nameLinkCss>
            name
        else
          <span css = { fontWeight: 500, fontSize: fontSize.S, color: "#1e293b" }>
            name
        if githubHandle
          <a
            href={`https://github.com/${githubHandle}`}
            target="_blank"
            rel="noreferrer"
            aria-label={`GitHub: @${githubHandle}`}
            css=iconLinkCss
          >
            <GithubIcon width="0.875rem" height="0.875rem" />
        if email
          <a
            href={`mailto:${email}`}
            aria-label={`Email: ${email}`}
            css=iconLinkCss
          >
            <MailIcon width="0.875rem" height="0.875rem" />
      if affiliation
        <p
          css =
            margin: 0
            color: "#64748b"
            fontSize: fontSize.S
            lineHeight: lineHeight
        >
          affiliation
