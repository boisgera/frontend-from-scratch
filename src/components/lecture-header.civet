// @ts-nocheck
"civet autoLet react jsxCode"

// Adapted from boisgera/python's src/components/Header.astro
// (uses the author's GitHub avatar instead of Gravatar).
import { GithubIcon } from ../icons/github.js
import { fontSize, space } from ../styles.js

export function Header({ frontmatter })
  { title, subtitle, author } := frontmatter ?? {}
  { name: authorName, title: authorTitle, affiliation: authorAffiliation, github, website } := author ?? {}
  githubHandle := github?.replace(/^@/, "")
  avatarUrl := if githubHandle then `https://github.com/${githubHandle}.png?size=128` else undefined
  <header
    css =
      marginBottom: space.XXL
  >
    <div css = { marginBottom: space.L }>
      <h1
        css =
          fontSize: fontSize.XXL
          lineHeight: 1
          fontWeight: 700
          color: "#020617"
          marginBottom: space.M
      >
        title
      if subtitle
        <p css = { color: "#64748b" }>
          subtitle
    if authorName
      <div css = { display: "flex", justifyContent: "left", gap: space.M }>
        if avatarUrl
          <img
            src={avatarUrl}
            alt="avatar"
            css =
              margin: 0
              flex: "0 72px"
              width: "72px"
              height: "72px"
              borderRadius: "50%"
          >
        <p
          css =
            margin: 0
            flex: "auto"
            fontSize: fontSize.S
            lineHeight: "1.25rem"
            color: "#1e293b"
        >
          authorName
          if authorTitle or authorAffiliation
            [
              <br key="author-br">
              [authorTitle, authorAffiliation].filter(Boolean).join(", ")
            ]
          if githubHandle or website
            [
              <br key="links-br">
              <span
                key="links"
                css =
                  display: "inline-flex"
                  alignItems: "center"
                  gap: space.XXS
              >
                if githubHandle
                  <a
                    href={`https://github.com/${githubHandle}`}
                    target="_blank"
                    rel="noreferrer"
                    css =
                      display: "inline-flex"
                      alignItems: "center"
                      gap: space.XXS
                      color: "inherit"
                      textDecoration: "none"
                  >
                    <GithubIcon />
                    `@${githubHandle}`
                if githubHandle and website
                  <span css = { color: "#64748b" }>{"·"}</span>
                if website
                  <a
                    href={website}
                    target="_blank"
                    rel="noreferrer"
                    css = { color: "inherit", textDecoration: "none" }
                  >
                    website
            ]
