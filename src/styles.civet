// @ts-nocheck
"civet autoLet react jsxCode"

import { Global } from @emotion/react

export fontSize =
  XXS: "0.625rem"
  XS: "0.75rem"
  S: "0.875rem"
  M: "1rem"
  L: "1.125rem"
  XL: "1.5rem"
  XXL: "2.25rem"

export space =
  XXS: "0.25rem"
  XS: "0.5rem"
  S: "0.75rem"
  M: "1rem"
  L: "1.5rem"
  XL: "2rem"
  XXL: "3rem"

// Shared layout constants (px). mainMaxWidth/mainMinWidth/tocWidth/gap
// are the numbers from the ask; bodyPadding is body's own inline
// padding, reused below so the TOC breakpoint stays derived rather than
// re-guessed by hand.
mainMaxWidth := 768
mainMinWidth := 384
tocWidth := 270
tocGap := 36
bodyPadding := 18

// Viewport width at which the right margin next to a max-width main
// (bodyContentWidth - mainMaxWidth) / 2, where bodyContentWidth is the
// viewport minus body's own left+right padding) first becomes wide
// enough to fit "gap + toc". Below this, .toc-rail is hidden.
tocBreakpoint := mainMaxWidth + 2 * (tocGap + tocWidth) + 2 * bodyPadding

// Typographic/layout choices ported from boisgera/python's MDXLayout.astro
styles =
  html:
    WebkitTextSizeAdjust: "none"
    hyphens: "auto"
    fontSize: "18px"

  body:
    WebkitFontSmoothing: "antialiased"
    fontFamily: "Inter, sans-serif"
    fontOpticalSizing: "auto"
    fontSize: fontSize.M
    lineHeight: "36px"
    padding: `${bodyPadding}px`

    // position: relative makes this the containing block for .toc-rail
    // (position: absolute), so the TOC's placement is computed purely
    // from main's own box below -- it has no effect on main itself,
    // which stays centered via its own margin-inline: auto regardless
    // of whether the TOC is present, hidden, or how wide it is.
    ".lecture-layout":
      position: "relative"

    // Documents need to be wrapped in a main element for this to work.
    // max/min-width + margin-inline: auto center main in the page on
    // their own, independent of any sibling -- this is what keeps main
    // dead-centered whether or not .toc-rail ends up shown.
    main:
      boxSizing: "border-box"
      maxWidth: `${mainMaxWidth}px`
      minWidth: `${mainMinWidth}px`
      width: "100%"
      marginInline: "auto"
      paddingInline: space.M

      // Default sizing for content images; an image with its own inline
      // style (e.g. a fixed height + objectFit) overrides this as-is,
      // since inline styles always beat an external stylesheet rule.
      img:
        width: "100%"
        height: "auto"
        borderRadius: "8px"

    // Absolutely positioned relative to .lecture-layout, so it never
    // participates in the layout that centers main. Anchored off
    // main's *max* width (main is only ever this wide when there's
    // room for the TOC to begin with -- below tocBreakpoint the whole
    // rail is hidden). top/bottom: 0 stretches it to .lecture-layout's
    // full (content-derived) height, giving the sticky nav inside room
    // to stick throughout the scroll.
    ".toc-rail":
      display: "none"
      position: "absolute"
      top: 0
      bottom: 0
      left: `calc(50% + ${mainMaxWidth / 2 + tocGap}px)`
      width: `${tocWidth}px`

    // Nested under body (not a top-level sibling) so this compiles to
    // "body .toc-rail" too -- same specificity as the default above, so
    // source order decides and this wins. A top-level ".toc-rail" rule
    // here would be *less* specific than "body .toc-rail" and would
    // always lose, no matter the media condition.
    `@media (min-width: ${tocBreakpoint}px)`:
      ".toc-rail":
        display: "block"

    // overflowY lives on .toc-list, not here: the scrollbar it produces
    // must not run alongside the "Contents" header/chevron row above it.
    ".toc":
      position: "sticky"
      top: "2rem"
      width: "100%"
      maxHeight: "calc(100vh - 4rem)"
      display: "flex"
      flexDirection: "column"

    // Scrolls independently of the "Contents" header/chevron above it
    // (minHeight: 0 is what lets a flex child actually shrink and scroll
    // instead of pushing .toc past its maxHeight).
    ".toc-list":
      flex: "1 1 auto"
      minHeight: 0
      overflowY: "auto"
      paddingRight: space.XS

    "img, picture, video, canvas":
      display: "block"
      maxWidth: "100%"
    "img, video":
      margin: "auto"
      marginBottom: space.L
      boxShadow: "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)"
    figure:
      margin: 0
      marginBottom: space.L
    figcaption:
      color: "#64748b"
      fontSize: fontSize.S
      textAlign: "center"
      maxWidth: "80%"
      marginInline: "auto"
      marginTop: space.S

    p:
      marginTop: 0
      marginBottom: space.XL

    "a:link, a:visited":
      color: "#000000"
    "a:hover, a:active":
      color: "#2563eb"
    a:
      transition: "color 0.15s ease"

    h1:
      fontSize: fontSize.XXL
      marginTop: "98px"
    h2:
      fontSize: fontSize.XL
      marginTop: "72px"
    h3:
      fontSize: fontSize.M
      marginTop: "36px"

    table:
      width: "100%"
      borderCollapse: "collapse"
      lineHeight: 1.5
      marginBottom: space.XXL
    "thead th":
      fontWeight: 600
      padding: "10px 12px"
      borderBottom: "1px solid #e5e7eb"
    "tbody td":
      padding: "10px 12px"
      borderBottom: "1px solid #f1f5f9"
      verticalAlign: "top"
    "tbody tr:hover":
      backgroundColor: "#f9fafb"

    ".dull":
      filter: "grayscale(60%) brightness(0.85)"
      transition: "filter 0.3s ease"
    ".dull:hover":
      filter: "none"

    ":not(pre) > code":
      fontVariantLigatures: "none"
      fontFamily: "Fira Code, monospace"
      backgroundColor: "#e2e8f0"
      color: "black"
      borderRadius: "0.25rem"
      padding: `0 ${space.XXS}`
    "pre:has(> code)":
      backgroundColor: "#f5f5f5"
      borderRadius: "0.25rem"
      overflowX: "auto"
      padding: `${space.M} ${space.XL}`
    "pre > code":
      lineHeight: "1rem"

export function Styles()
  <Global {styles}>
