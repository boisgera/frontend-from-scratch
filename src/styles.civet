// @ts-nocheck
"civet autoLet react jsxCode"

import { Global } from @emotion/react

export fontSize =
  XXS: "0.625rem"
  XS: "0.75rem"
  S: "0.875rem"
  M: "1rem"
  L: "1.125rem"
  XL: "1.5rem"
  XXL: "2.25rem"

// Typographic/layout choices ported from boisgera/python's MDXLayout.astro
styles =
  html:
    WebkitTextSizeAdjust: "none"
    hyphens: "auto"
    fontSize: "18px"

  body:
    WebkitFontSmoothing: "antialiased"
    fontFamily: "Inter, sans-serif"
    fontOpticalSizing: "auto"
    fontSize: fontSize.M
    lineHeight: "36px"
    padding: "18px"

    // Three symmetric columns (1fr / main / 1fr) so main never shifts
    // when .toc is empty/hidden -- but capped at its own natural content
    // width and centered as a block (marginInline: auto), so once a
    // viewport is wide enough for that content to fit, .toc sits flush
    // against main (like any normal docs sidebar) instead of hugging the
    // left edge of a much-wider-than-260px 1fr column, which is what was
    // producing a big empty gap on the right that read as "off-center".
    ".lecture-layout":
      display: "grid"
      gridTemplateColumns: "1fr min(768px, 100%) 1fr"
      columnGap: "3rem"
      alignItems: "start"
      maxWidth: "calc(768px + 2 * 3rem + 260px)"
      marginInline: "auto"

    // Documents need to be wrapped in a main element for this to work.
    main:
      gridColumn: "2"
      width: "100%"
      paddingInline: "1rem"

    // overflowY lives on .toc-list, not here: the scrollbar it produces
    // must not run alongside the "Contents" header/chevron row above it.
    // justifySelf keeps it hugging main's edge rather than centered (or
    // stranded far right) in its own, potentially much wider, 1fr column.
    ".toc":
      gridColumn: "3"
      justifySelf: "start"
      position: "sticky"
      top: "2rem"
      width: "260px"
      maxHeight: "calc(100vh - 4rem)"
      display: "flex"
      flexDirection: "column"

    // Scrolls independently of the "Contents" header/chevron above it
    // (minHeight: 0 is what lets a flex child actually shrink and scroll
    // instead of pushing .toc past its maxHeight).
    ".toc-list":
      flex: "1 1 auto"
      minHeight: 0
      overflowY: "auto"
      paddingRight: "0.5rem"

    "img, picture, video, canvas":
      display: "block"
      maxWidth: "100%"
    "img, video":
      margin: "auto"
      marginBottom: "1.5rem"
      boxShadow: "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)"
    figure:
      margin: 0
      marginBottom: "1.5rem"

    p:
      marginTop: 0
      marginBottom: "2rem"

    "a:link, a:visited":
      color: "#000000"
    "a:hover, a:active":
      color: "#2563eb"
    a:
      transition: "color 0.15s ease"

    h1:
      fontSize: fontSize.XXL
      marginTop: "98px"
    h2:
      fontSize: fontSize.XL
      marginTop: "72px"
    h3:
      fontSize: fontSize.M
      marginTop: "36px"

    table:
      width: "100%"
      borderCollapse: "collapse"
      lineHeight: 1.5
      marginBottom: "3rem"
    "thead th":
      fontWeight: 600
      padding: "10px 12px"
      borderBottom: "1px solid #e5e7eb"
    "tbody td":
      padding: "10px 12px"
      borderBottom: "1px solid #f1f5f9"
      verticalAlign: "top"
    "tbody tr:hover":
      backgroundColor: "#f9fafb"

    ".dull":
      filter: "grayscale(60%) brightness(0.85)"
      transition: "filter 0.3s ease"
    ".dull:hover":
      filter: "none"

    ":not(pre) > code":
      fontVariantLigatures: "none"
      fontFamily: "Fira Code, monospace"
      backgroundColor: "#e2e8f0"
      color: "black"
      borderRadius: "0.25rem"
      padding: "0rem 0.25rem"
    "pre:has(> code)":
      backgroundColor: "#f5f5f5"
      borderRadius: "0.25rem"
      overflowX: "auto"
      padding: "1rem 2rem"
    "pre > code":
      lineHeight: "1rem"

  "@media (max-width: 1100px)":
    ".toc":
      display: "none"

export function Styles()
  <Global {styles}>
