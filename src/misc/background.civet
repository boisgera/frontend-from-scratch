// @ts-nocheck
"civet autoLet react jsxCode"

import React from react
import { motion } from motion/react

centerX = 50
centerY = 50
orbitRadius = 25
diskRadius = 10

// The `do` version is bugged in autoLet mode
// Here I just want to scope N.
centerPath := (=> 
  N := 100
  for n of [0...N]
    angle := n / N * 2 * Math.PI  
    [
      centerX + orbitRadius * Math.cos(angle), 
      centerY + orbitRadius * Math.sin(angle)
    ]
  )()

export function Background()
  <svg
    viewBox="0 0 100 100"
    preserveAspectRatio="xMidYMid slice"
    style =
      position: "fixed"
      top: 0
      left: 0
      width: "100vw"
      height: "100vh"
      zIndex: -1
  >
    <rect
      x=0
      y=0
      width=100
      height=100
      fill="hsl(0, 0%, 98%)"
    >
    <motion.circle
      r=diskRadius
      fill="hsl(0, 0%, 90%)"
      cx=centerPath[0][0]
      cy=centerPath[0][1]
      animate =
        cx: centerPath.map [x, y] => x
        cy: centerPath.map [x, y] => y
      transition =
        duration: 24
        repeat: Infinity
        ease: "linear"
    >
