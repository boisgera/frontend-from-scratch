#!/bin/bash

build() {
  local tsx

  if [[ $# -eq 0 ]]; then
    echo "Usage: build <name> [name...]" >&2
    return 1
  fi

  for name in "$@"; do
    tsx="dist/${name}.tsx"

    if [[ -f "dist/${name}.civet" ]]; then
      npx @danielx/civet -c "dist/${name}.civet" -o "$tsx" || return 1
    elif [[ -f "dist/${name}.mdx" ]]; then
      bun run scripts/mdx-compile.js "dist/${name}.mdx" "$tsx" || return 1
    else
      echo "Error: no dist/${name}.civet or dist/${name}.mdx found" >&2
      return 1
    fi

    npx esbuild "$tsx" --outfile="dist/${name}.js"
  done
}

if [[ $# -eq 0 ]]; then
  build button warning math-text page app main
else
  build "$@"
fi