#!/bin/bash

# Actually, we may need a `build` dir (or rather `.build`) AND a `dist` dir
# since we may want to filter out the source files afterwards.
rm -rf dist
cp -rf src dist

npx @danielx/civet -c dist/main.civet -o dist/main.tsx
npx esbuild dist/main.tsx --outfile=dist/main.js

npx @danielx/civet -c dist/app.civet -o dist/app.tsx
npx esbuild dist/app.tsx --outfile=dist/app.js

npx @danielx/civet -c dist/warning.civet -o dist/warning.tsx
npx esbuild dist/warning.tsx --outfile=dist/warning.js

./mdx-compile.js dist/page.mdx dist/page.tsx
npx esbuild dist/page.tsx --outfile=dist/page.js

./mdx-compile.js dist/math-text.mdx dist/math-text.tsx
npx esbuild dist/math-text.tsx --outfile=dist/math-text.js