// @ts-nocheck
"civet autoLet"

// Node
import assert from "node:assert"
import { existsSync } from node:fs
import { execFileSync } from node:child_process
import { cp, mkdir, readdir, readFile, rm, writeFile } from node:fs/promises
import { basename, dirname, extname, join } from node:path

// React
import { createElement } from "react";
// renderToStaticMarkup omits the <!-- --> comments React inserts between
// adjacent text-only children; without them the browser's HTML parser
// merges those children into a single text node, and hydrateRoot then
// finds fewer nodes than the client tree expects. renderToString keeps
// them, so it's the one that's actually safe to hydrate later.
import { renderToString } from "react-dom/server";
import { CacheProvider } from "@emotion/react";
import createCache from "@emotion/cache";
import createEmotionServer from "@emotion/server/create-instance";

// Third-party
import * as civet from @danielx/civet
import * as esbuild from esbuild
import { parseHTML } from linkedom
// 📝 The mdx math plugins require that we use the async MDX compiler API.
import * as mdx from @mdx-js/mdx
import remarkMath from remark-math
import rehypeSlug from rehype-slug
import rehypeMathJax from rehype-mathjax
import remarkFrontmatter from remark-frontmatter
import remarkMdxFrontmatter from remark-mdx-frontmatter
import remarkGfm from remark-gfm
import rehypeShiki from @shikijs/rehype

/** "aaa.bbb.ccc" -> [ 'aaa.bbb', '.ccc' ] and "aaa" -> [ 'aaa', ''] */
function splitExt(path)
  ext = extname path
  assert.equal (typeof ext), "string"
  [
    path[..(-ext.length - 1)], 
    ext
  ]

LIBS := [
  "react"
  "react-dom"
  "react-dom/client"
  "@emotion/react"
  "@emotion/react/jsx-runtime"
  "@emotion/react/jsx-dev-runtime"
  "@emotion/cache"
  "motion/react"
  "tldraw"
  "three"
  "@react-three/fiber"
  // "tldraw/tldraw.css" // Ooops
]

ROOT := import.meta.dirname |> dirname

OUTDIR := ".build"  // relative to project root
LIBDIR := "libs"    // relative to OUTDIR
BASE := "base.html" // relative to OUTDIR, wraps rendered MDX pages
// Shared between the server-side cache (below) and the client-side one
// (injected into the hydration <script>) so extracted <style> tags are
// recognized rather than duplicated once the client cache takes over.
EMOTION_KEY := "app"

/** MDX compiler: a <doc.mdx> filename generates a "doc.tsx" output file */
function compileMdx(inputFilename: string)
  [name, ext] := splitExt inputFilename
  assert.equal ext, ".mdx"
  source = await readFile inputFilename, "utf8"
  result = await mdx.compile 
    source
    jsx: true
    jsxImportSource: "@emotion/react"
    remarkPlugins:
      • remarkFrontmatter 
      • remarkMdxFrontmatter 
      • remarkGfm
      • remarkMath
    rehypePlugins:
      • rehypeSlug
      • rehypeMathJax
      • • rehypeShiki
        • theme: "github-dark"
          langs: ["python", "bash", "console", "jsx"]
    outputFormat: "program"

  outputFilename = `${name}.tsx`
  await writeFile outputFilename, result.toString()

RENDER_MODES := ["static", "hydrate", "client"]
// "client" ships zero SSR markup, so any component unsafe to import under
// Node (e.g. WebGL canvases, browser-only globals) is only ever touched in
// the browser. That's why it's the default: it can't fail a build the way
// "static" or "hydrate" can, since those both require successfully calling
// renderToString on the page.
DEFAULT_RENDER_MODE := "client"

/** Inject a rendered page's body markup into the base.html shell.
    Styles are passed in as already-extracted <style> tags (see buildHtml)
    and land in <head>, not interleaved into the body: Emotion's "Default
    Approach" (styles rendered as inline siblings) only works for pages
    that are never hydrated, since the client-side cache inserts styles
    into <head> as a side effect instead of rendering them into the tree,
    and hydrateRoot would flag the extra server-rendered <style> node as
    a mismatch. */
function wrapPage(bodyHtml: string, opts: { title?: string, styleTags?: string, render: string, jsName?: string })
  template = await readFile(join(ROOT, OUTDIR, BASE), "utf8")
  { document } := parseHTML(template)
  document.body.innerHTML = bodyHtml
  if opts.title
    document.title = opts.title
  if opts.styleTags
    styleContainer = document.createElement "div"
    styleContainer.innerHTML = opts.styleTags
    for style of [...styleContainer.children]
      document.head.appendChild style
  if opts.render == "hydrate" or opts.render == "client"
    // "hydrate" mounts onto server-rendered markup already in body (must
    // match <Page/>'s client tree exactly, hence hydrateRoot); "client"
    // mounts onto an empty body, so createRoot is used instead since
    // there's no server markup to reconcile against.
    mount := if opts.render == "hydrate"
      "ReactDOMClient.hydrateRoot(document.body, element);"
    else
      "ReactDOMClient.createRoot(document.body).render(element);"
    script = document.createElement "script"
    script.type = "module"
    // Appended to <head>, not <body>: for "hydrate", a trailing body child
    // would itself become an unexpected node and trip a hydration mismatch
    // the moment hydrateRoot runs.
    script.textContent = `
      import ReactDOMClient from "react-dom/client";
      import React from "react";
      import createCache from "@emotion/cache";
      import { CacheProvider } from "@emotion/react";
      import Page from "./${opts.jsName}";
      const cache = createCache({ key: "${EMOTION_KEY}" });
      const element = React.createElement(CacheProvider, { value: cache }, React.createElement(Page));
      ${mount}
    `
    document.head.appendChild script
  "<!DOCTYPE html>\n" + document.documentElement.outerHTML

export function buildLibs()
  await esbuild.build
    entryPoints: LIBS
    bundle: true
    splitting: true
    format: "esm"
    outdir: join(OUTDIR, LIBDIR)
    define: { "process.env.NODE_ENV": '"production"' }

/** Transpile civet, mdx and tsx files to js, in-place */
export function buildJs(...filenames)
  if filenames.length == 0
    console.error "Usage: build <name> [name...]"
    process.exit 1

  for filename of filenames
    [ name, ext ] = splitExt filename
    if ext == ".civet"
      source = await readFile(`${name}.civet`, "utf8")
      compiled = await civet.compile source
      await writeFile(`${name}.tsx`, compiled)
    else if ext == ".mdx"
      await compileMdx(`${name}.mdx`) // generate a `${name}.tsx` file
    // Now we compile the tsx file (source or generated) to js.
    // jsxImportSource is @emotion/react project-wide (mdx.compile above
    // targets the same runtime), so any component or page can use the
    // `css` prop with no per-file pragma.
    if existsSync `${name}.tsx`
      await esbuild.build
        entryPoints: [`${name}.tsx`]
        outfile: `${name}.js`
        jsx: "automatic"
        jsxImportSource: "@emotion/react"

/** Render each compiled mdx page's js module to HTML, wrapped in base.html */
export function buildHtml(...filenames)
  for filename of filenames
    [ name, ext ] = splitExt filename
    if ext == ".mdx"
      { default: Page, frontmatter } := await import `${name}.js`
      render := frontmatter?.render ?? DEFAULT_RENDER_MODE
      assert.ok RENDER_MODES.includes(render), `${name}.mdx: invalid render mode "${render}" (expected one of ${RENDER_MODES.join ", "})`

      body = ""
      styleTags = ""
      // "client" mode never calls renderToString: the whole point is to
      // avoid running page code (e.g. WebGL canvases) under Node at all.
      if render != "client"
        cache := createCache({ key: EMOTION_KEY })
        { extractCriticalToChunks, constructStyleTagsFromChunks } := createEmotionServer(cache)
        element := createElement(CacheProvider, { value: cache }, createElement(Page))
        body = renderToString(element)
        styleTags = constructStyleTagsFromChunks(extractCriticalToChunks(body))

      html := await wrapPage(body, {
        title: frontmatter?.title
        styleTags: styleTags
        render: render
        jsName: basename(`${name}.js`)
      })
      await writeFile(`${name}.html`, html)

export function buildAll()
  src = join(ROOT, "src")
  outdir = join(ROOT, OUTDIR)
  await rm(outdir, recursive: true, force: true)

  await cp src, outdir, recursive: true

  files = await readdir(outdir, recursive: true)
  outFiles = for file of files then join(ROOT, `${OUTDIR}/${file}`)
  await buildJs(...outFiles)
  // Runs only after every file above is compiled, so that a page's
  // imports (e.g. other components) are guaranteed to exist on disk.
  await buildHtml(...outFiles)

  await buildLibs()

function main()
  buildAll()

if import.meta.main
  main()    