// @ts-nocheck
"civet autoLet"

// Node
import assert from "node:assert"
import { existsSync } from node:fs
import { execFileSync } from node:child_process
import { cp, mkdir, readdir, readFile, rm, writeFile } from node:fs/promises
import { dirname, extname, join } from node:path

// React
import { renderToStaticMarkup } from "react-dom/server";

// Third-party
import * as civet from @danielx/civet
import * as esbuild from esbuild
import { parseHTML } from linkedom

// Local
import * as mdx from "./mdx.civet"

/** "aaa.bbb.ccc" -> [ 'aaa.bbb', '.ccc' ] and "aaa" -> [ 'aaa', ''] */
function splitExt(path)
  ext = extname path
  assert.equal (typeof ext), "string"
  [
    path[..(-ext.length - 1)], 
    ext
  ]

LIBS := [
  "react"
  "react-dom"
  "react-dom/client"
  "react/jsx-runtime"
  "react/jsx-dev-runtime"
  "@emotion/css"
  "motion/react"
  "tldraw"
  // "tldraw/tldraw.css" // Ooops
]

OUTDIR := ".build" // relative to project root
LIBDIR := "libs" // relative to OUTDIR
BASE := "base.html" // relative to OUTDIR, wraps rendered MDX pages

/** Inject a rendered page's body markup into the base.html shell */
function wrapPage(bodyHtml: string, title?: string)
  root = import.meta.dirname |> dirname
  template = await readFile(join(root, OUTDIR, BASE), "utf8")
  { document } := parseHTML(template)
  document.body.innerHTML = bodyHtml
  if title
    document.title = title
  "<!DOCTYPE html>\n" + document.documentElement.outerHTML

export function buildLibs()
  await esbuild.build
    entryPoints: LIBS
    bundle: true
    splitting: true
    format: "esm"
    outdir: join(OUTDIR, LIBDIR)
    define: { "process.env.NODE_ENV": '"production"' }

/** Transpile civet, mdx and tsx files to js, in-place */
export function buildJs(...filenames)
  if filenames.length == 0
    console.error "Usage: build <name> [name...]"
    process.exit 1

  for filename of filenames
    [ name, ext ] = splitExt filename
    if ext == ".civet"
      source = await readFile(`${name}.civet`, "utf8")
      compiled = await civet.compile source
      await writeFile(`${name}.tsx`, compiled)
    else if ext == ".mdx"
      await mdx.compile(`${name}.mdx`) // generate a `${name}.tsx` file
    // Now we compile the tsx file (source or generated) to js
    if existsSync `${name}.tsx`
      await esbuild.build
        entryPoints: [`${name}.tsx`]
        outfile: `${name}.js`

/** Render each compiled mdx page's js module to HTML, wrapped in base.html */
export function buildHtml(...filenames)
  for filename of filenames
    [ name, ext ] = splitExt filename
    if ext == ".mdx"
      { default: Page, frontmatter } := await import `${name}.js`
      body := Page() |> renderToStaticMarkup
      html := await wrapPage(body, frontmatter?.title)
      await writeFile(`${name}.html`, html)

export function buildAll()
  root = import.meta.dirname |> dirname
  src = join(root, "src")
  outdir = join(root, OUTDIR)
  await rm(outdir, recursive: true, force: true)

  await cp src, outdir, recursive: true

  files = await readdir(outdir, recursive: true)
  outFiles = for file of files then join(root, `${OUTDIR}/${file}`)
  await buildJs(...outFiles)
  // Runs only after every file above is compiled, so that a page's
  // imports (e.g. other components) are guaranteed to exist on disk.
  await buildHtml(...outFiles)

  await buildLibs()

function main()
  buildAll()

if import.meta.main
  main()    