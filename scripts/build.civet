// @ts-nocheck
"civet autoLet"

// Node
import assert from "node:assert"
import { existsSync } from node:fs
import { execFileSync } from node:child_process
import { cp, mkdir, readdir, readFile, rm, writeFile } from node:fs/promises
import { dirname, extname, join } from node:path

// React
import { renderToStaticMarkup } from "react-dom/server";

// Third-party
import * as civet from @danielx/civet
import * as esbuild from esbuild

// Local
import * as mdx from "./mdx.civet"

/** "aaa.bbb.ccc" -> [ 'aaa.bbb', '.ccc' ] and "aaa" -> [ 'aaa', ''] */
function splitExt(path)
  ext = extname path
  assert.equal (typeof ext), "string"
  [
    path[..(-ext.length - 1)], 
    ext
  ]

LIBS := [
  "react"
  "react-dom"
  "react-dom/client"
  "react/jsx-runtime"
  "react/jsx-dev-runtime"
  "@emotion/css"
  "motion/react"
  "tldraw"
  // "tldraw/tldraw.css" // Ooops
]

/** Transpile civet, mdx and tsx files to js */
export function build(...filenames)

  // Bundle the libraries into a single file for the browser
  await esbuild.build
    entryPoints: LIBS
    bundle: true
    splitting: true
    format: "esm"
    outdir: "libs"
    define: { "process.env.NODE_ENV": '"production"' }

  if filenames.length == 0
    console.error "Usage: build <name> [name...]"
    process.exit 1

  for filename of filenames
    [ name, ext ] = splitExt filename
    if ext == ".civet"
      source = await readFile(`${name}.civet`, "utf8")
      compiled = await civet.compile source
      await writeFile(`${name}.tsx`, compiled)
    else if ext == ".mdx"
      await mdx.compile(`${name}.mdx`) // generate a `${name}.tsx` file
    // Now we compile the tsx file (source or generated) to js
    await esbuild.build 
      entryPoints: [`${name}.tsx`] 
      outfile: `${name}.js`
    // TODO: SR: for MDX pages, generate the `{name}.html` file too
    // if ext == ".mdx"
    //   console.log `SSR for ${name}.mdx\n`
    //   { default: Page, frontmatter } := await import `${name}.js`
    //   // html := Page() |> renderToStaticMarkup
    //   // console.log `${name}.mdx -> HTML:`
    //   // console.log html


/** Build all src files into the dist directory */
export function buildAll()
  root = import.meta.dirname |> dirname
  src = join(root, "src")
  dist = join(root, "dist")
  await rm(dist, recursive: true, force: true)
  await cp(src, dist, recursive: true)
  files = await readdir(dist, recursive: true)
  distFiles = for file of files then join(root, `dist/${file}`)
  build(...distFiles)

function main()
  args = process.argv[2..]
  if args.length == 0
    buildAll()
  else
    build(...args)

if import.meta.main
  main()    