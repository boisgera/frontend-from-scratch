// @ts-nocheck
"civet autoLet" 

// Node
import { parseArgs } from node:util
import { readFile, writeFile } from node:fs/promises

// MDX
// 📝 The math plugins require that we use the async MDX compiler API.
import * as mdx from @mdx-js/mdx
import remarkMath from remark-math
import rehypeMathJax from rehype-mathjax

/** MDX compiler: a <doc.mdx> filename generates a "doc.tsx" output file */
export function compile(inputFilename: string)
  source = await readFile inputFilename, "utf8"
  result = await mdx.compile source,
    jsx: true,
    jsxImportSource: "react"
    remarkPlugins: [remarkMath]
    rehypePlugins: [rehypeMathJax]
    outputFormat: "program"
  outputFilename = inputFilename.replace /\.mdx$/, ".tsx"
  await writeFile outputFilename, result.toString()

usage = "Usage: civet mdx.civet <input-file.mdx>"

/** Command-line interface */
function main()
  { values: options, positionals: args } = 
    parseArgs
      options:
        help:
          type: "boolean"
          short: "h" 
      allowPositionals: true

  if options.help
    console.log usage
    process.exit 0    

  if args.length != 1
    console.error usage
    process.exit 1

  inputFile = process.argv[2]
  await compile inputFile

if import.meta.main
  main()